    {
        "id": "vr-001",
        "subject": "verbal-reasoning",
        "topic": "analogy",
        "difficulty": 1,
        "question": "BOOK : LIBRARY :: PAINTING : ?",
        "choices": [
            {
                "key": "A",
                "text": "Canvas"
            },
            {
                "key": "B",
                "text": "Museum"
            },
            {
                "key": "C",
                "text": "Artist"
            },
            {
                "key": "D",
                "text": "Color"
            }
        ],
        "answer": "B",
        "explanation": "A book is stored/displayed in a library. Similarly, a painting is stored/displayed in a museum.",
        "wrongExplanations": {
            "A": "A canvas is what a painting is made on, not where it is displayed.",
            "C": "An artist creates a painting, but the analogy is about where items are kept.",
            "D": "Color is a material used in painting, not a place."
        }
    },
    {
