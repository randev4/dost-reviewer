    {
        "id": "vr-006",
        "subject": "verbal-reasoning",
        "topic": "series",
        "difficulty": 3,
        "question": "Complete the series: 1, 1, 2, 3, 5, 8, ___",
        "choices": [
            {
                "key": "A",
                "text": "10"
            },
            {
                "key": "B",
                "text": "11"
            },
            {
                "key": "C",
                "text": "13"
            },
            {
                "key": "D",
                "text": "15"
            }
        ],
        "answer": "C",
        "explanation": "This is the Fibonacci sequence where each number is the sum of the two preceding numbers: 5 + 8 = 13.",
        "wrongExplanations": {
            "A": "10 is 8 + 2. In this pattern, you add the two most recent numbers: 5 + 8.",
            "B": "11 is 8 + 3. Use the last two numbers: 8 + 5 = 13.",
            "D": "15 does not fit the pattern. Each term = sum of previous two terms."
        }
    },
