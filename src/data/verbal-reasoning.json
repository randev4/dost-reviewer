        "difficulty": 1,
        "question": "HOT : COLD :: TALL : ?",
        "choices": [
            {
                "key": "A",
                "text": "Big"
            },
            {
                "key": "B",
                "text": "Short"
            },
            {
                "key": "C",
                "text": "Long"
            },
            {
                "key": "D",
                "text": "Thin"
            }
        ],
        "answer": "B",
        "explanation": "Hot and cold are antonyms (opposites). The antonym of tall is short.",
        "wrongExplanations": {
            "A": "Big is a synonym-like word for tall, not its opposite.",
            "C": "Long relates to horizontal measurement; the opposite of tall (vertical) is short.",
            "D": "Thin is the opposite of thick or fat, not tall."
        }
    },
