    {
        "id": "vr-004",
        "subject": "verbal-reasoning",
        "topic": "series",
        "difficulty": 2,
        "question": "Complete the series: 2, 6, 18, 54, ___",
        "choices": [
            {
                "key": "A",
                "text": "108"
            },
            {
                "key": "B",
                "text": "162"
            },
            {
                "key": "C",
                "text": "72"
            },
            {
                "key": "D",
                "text": "216"
            }
        ],
        "answer": "B",
        "explanation": "Each number is multiplied by 3: 2→6→18→54→162. This is a geometric sequence with ratio 3.",
        "wrongExplanations": {
            "A": "108 is 54 × 2. The pattern uses a multiplier of 3, not 2.",
            "C": "72 is 54 + 18. The pattern is multiplication, not addition of previous terms.",
            "D": "216 is 54 × 4. The common ratio is 3, not 4."
        }
    },
